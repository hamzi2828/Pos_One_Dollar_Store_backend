# Backend environment variables

# Server
PORT=4000
NODE_ENV=development

# Admin panel URL(s) allowed by CORS, comma separated
FRONTEND_ORIGIN=http://localhost:3000

# MongoDB
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database_name

# JWT secret (a long random string)
JWT_SECRET=your_jwt_secret_key_here

# Uploads (Vercel Blob in production; local ./uploads when empty)
BLOB_READ_WRITE_TOKEN=
UPLOAD_MAX_FILE_SIZE_MB=5

# Shared response cache (optional; in-memory when empty)
REDIS_URL=

# Vercel cron secret for /api/counters/check-cutoffs
CRON_SECRET=

# npm run seed:admin
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
